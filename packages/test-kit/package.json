{
  "name": "@TBS/test-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-package deterministic fixtures and acceptance helpers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@TBS/application": "workspace:*",
    "@TBS/common": "workspace:*",
    "@TBS/game-core": "workspace:*",
    "@TBS/game-rules": "workspace:*",
    "@TBS/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "layer:test",
      "type:library"
    ]
  }
}
