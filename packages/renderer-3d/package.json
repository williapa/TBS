{
  "name": "@TBS/renderer-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React Three Fiber renderer for renderer-neutral TBS board view models",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "assets"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "8.18.0",
    "@TBS/presentation": "workspace:*",
    "react": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.170.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "nx": {
    "projectType": "library",
    "tags": ["layer:renderer", "type:library"]
  }
}
