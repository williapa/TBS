{
  "name": "@TBS/game-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free observation and action representation for TBS AI models",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@TBS/game-core": "workspace:*",
    "@TBS/game-rules": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "nx": {
    "tags": [
      "layer:domain",
      "type:library"
    ]
  }
}
