# ======================================
# OS / editor
# ======================================
.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo

# ======================================
# Logs
# ======================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ======================================
# Environment files
# Keep example env files tracked
# ======================================
.env
.env.*
!.env.example
!.env.*.example

# ======================================
# Dependencies
# ======================================
node_modules/
.pnpm-store/

# ======================================
# Build artifacts
# ======================================
dist/
build/
coverage/
out/
.tmp/
temp/

# TypeScript incremental metadata
*.tsbuildinfo

# ======================================
# Package manager
# Using pnpm workspaces, so commit only the root pnpm lockfile
# ======================================
yarn.lock
package-lock.json

# ======================================
# Frontend caches / tooling
# ======================================
.eslintcache
.stylelintcache
.cache/
.nx/
.parcel-cache/

# ======================================
# Test artifacts
# ======================================
junit.xml
test-results/
supabase/functions/*/generated/
playwright-report/

# ======================================
# Runtime files
# ======================================
*.pid
*.pid.lock
*.seed

# ======================================
# Docker
# Track Dockerfiles and compose files.
# Ignore generated/exported image artifacts and local runtime data.
# ======================================
*.tar
docker-data/
.docker/

# ======================================
# Server local data
# Adjust these to match your actual server paths
# ======================================
server/data/
server/uploads/
server/*.db
server/*.sqlite
server/*.sqlite3

# DynamoDB local persisted files
server/dynamodb-local/data/
server/dynamodb-local/docker/dynamodb/*.db

# ======================================
# Misc
# ======================================
