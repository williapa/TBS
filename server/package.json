{
  "name": "@TBS/server",
  "version": "1.0.0",
  "description": "TBS server for turn based gameplay w/ websockets (& http)",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write",
    "db:create": "node dist/data/createTable.js",
    "db:delete": "node dist/data/deleteTable.js",
    "db:clear-games": "node dist/data/deleteGames.js"
  },
  "keywords": [
    "game",
    "TBS"
  ],
  "author": "Paul Williams",
  "license": "ISC",
  "dependencies": {
    "@TBS/common": "1.0.0",
    "@aws-sdk/client-dynamodb": "^3.1009.0",
    "@aws-sdk/lib-dynamodb": "^3.1009.0",
    "@types/uuid": "^11.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
